---
import ThemeToggle from "./ThemeToggle.astro";
---

<header class="fixed inset-x-0 top-0 z-10 flex justify-center px-4 py-3 text-black dark:text-white">
  <nav
    aria-label="Main navigation"
    class="navbar-shell flex w-fit max-w-xl items-center justify-center gap-1 rounded-full px-2 py-2"
  >
    <a class="nav-link" href="/portfolio/">Home</a>
    <a class="nav-link" href="/portfolio/posts/">Blog</a>
    <span class="nav-divider" aria-hidden="true">|</span>
    <ThemeToggle />
  </nav>
</header>

<style>
  .navbar-shell {
    --nav-bg-scrolled: rgb(255 255 255 / 0.72);
    --nav-shadow-scrolled: 0 8px 24px rgb(0 0 0 / 0.08);
    background: transparent;
    transition:
      background-color 180ms ease,
      box-shadow 180ms ease,
      backdrop-filter 180ms ease;
    animation: nav-shadow 1ms linear both;
    animation-timeline: scroll();
    animation-range: 0 100px;
  }

  .nav-divider {
    color: currentColor;
    font-size: 0.875rem;
    line-height: 1;
    opacity: 0.35;
    user-select: none;
  }

  .nav-link {
    border-radius: 9999px;
    color: currentColor;
    font-size: 0.875rem;
    font-weight: 500;
    padding: 0.5rem 0.8rem;
    transition: background-color 160ms ease, opacity 160ms ease;
  }

  .nav-link:hover,
  .nav-link:focus-visible {
    background: rgb(0 0 0 / 0.06);
    opacity: 0.7;
    outline: none;
  }

  :global(.dark) .navbar-shell {
    --nav-bg-scrolled: rgb(15 23 42 / 0.72);
    --nav-shadow-scrolled: 0 8px 24px rgb(0 0 0 / 0.4);
  }

  :global(.dark) .nav-link:hover,
  :global(.dark) .nav-link:focus-visible {
    background: rgb(255 255 255 / 0.12);
  }

  @keyframes nav-shadow {
    to {
      background: var(--nav-bg-scrolled);
      box-shadow: var(--nav-shadow-scrolled);
      backdrop-filter: blur(14px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .navbar-shell {
      animation: none;
    }
  }
</style>
